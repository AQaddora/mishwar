# Copy to .env and fill in. Never commit a .env with real values: .gitignore refuses them.
# Every variable is described in README.md, "Configuration".

# --- Database ---------------------------------------------------------------
# Postgres connection string (Dokku provides it in production)
DATABASE_URL=

# --- Auth.js ----------------------------------------------------------------
# Random secret for Auth.js sessions, for example from: openssl rand -base64 32
# Required in production. In QA mode a per-process secret is generated when unset.
AUTH_SECRET=
# Public address of the app, for example http://localhost:3000 (usually not needed:
# the proxy's host is trusted)
AUTH_URL=
# Google OAuth client ID; with no ID and secret the Google button is hidden
AUTH_GOOGLE_ID=
# Google OAuth client secret; never commit a real value
AUTH_GOOGLE_SECRET=

# --- QA only ----------------------------------------------------------------
# Set to 1 only for Fleet QA and local work: turns on /api/qa-login and /api/qa-cleanup.
# Never set in production.
QA_MODE=
# Optional extra lock for a QA copy on the public internet: /api/qa-login and
# /api/qa-cleanup then need ?key=<this value> (or an x-qa-key header)
QA_LOGIN_KEY=

# --- Optional features ------------------------------------------------------
# Anthropic API key. Turns on the planner's AI step (POST /api/plan-ai); a 404 without it.
ANTHROPIC_API_KEY=

# --- Set by the server, not by hand ----------------------------------------
# The deployed commit, reported by GET /api/health and read by the service worker
GIT_REV=
# Port for npm start and the container (default 3000)
PORT=
