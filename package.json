{
  "name": "mishwar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "start": "prisma migrate deploy && HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "test": "vitest run",
    "lint": "eslint",
    "qa:seed": "prisma migrate deploy && node scripts/qa-seed.mjs",
    "gazetteer": "node scripts/fetch-gazetteer.mjs",
    "strip-outline": "node scripts/fetch-strip-outline.mjs",
    "sim": "node qa/simulation/run.mjs",
    "sim:issues": "node qa/simulation/file-issues.mjs",
    "sim:cleanup": "node qa/simulation/cleanup.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "leaflet": "1.9.4",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright-core": "^1.63.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
