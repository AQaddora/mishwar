// Auth.js models for @auth/prisma-adapter, plus the Mishwar role and phone on User.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  rider
  driver
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Set once on /welcome and never changed.
  role          Role?
  phone         String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  vehicle       Vehicle?
  routes        Route[]
  scheduleDays  ScheduleDay[]
  outboxEntries OutboxEntry[]
  trips         Trip[]
  bookings      Booking[]
  locationShares LocationShare[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

enum VehicleType {
  car
  bus
  ajala
}

// One vehicle per driver. Seats are whatever the driver sets.
model Vehicle {
  id               String      @id @default(cuid())
  driverId         String      @unique
  type             VehicleType
  seats            Int
  // Out of service from this day (YYYY-MM-DD, Asia/Gaza). Null: in service.
  maintenanceFrom  String?
  // Last day out of service. Null with a from-day: until the driver says it's back.
  maintenanceUntil String?
  updatedAt        DateTime    @updatedAt
  driver           User        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  // Set when a running vehicle with bookings is first seen more than 500 m from its route
  // line; cleared when it is back. Two minutes of it tells the booked riders (M5).
  offRouteSince    DateTime?
  photos           Photo[]
  position         VehiclePosition?
}

// Photos live in Postgres: the container disk is wiped on every deploy.
// The URL carries the content hash, so a cached copy is never stale.
model Photo {
  id        String   @id @default(cuid())
  vehicleId String
  hash      String
  mime      String
  bytes     Bytes
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, hash])
  @@index([hash])
}

// A driver keeps several routes; exactly one is the default. Each runs both ways.
model Route {
  id        String      @id
  driverId  String
  name      String
  isDefault Boolean     @default(false)
  updatedAt DateTime    @updatedAt
  // Soft delete, so a deletion can reach phones through sync.
  deletedAt DateTime?
  driver    User        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  stops     RouteStop[]
  days      ScheduleDay[]
  trips     Trip[]
  bookings  Booking[]

  @@index([driverId])
}

// placeId is an OSM id from data/gazetteer.json, like "node/123456".
model RouteStop {
  routeId  String
  position Int
  placeId  String
  route    Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@id([routeId, position])
}

// The weekly schedule: at most one row per weekday (ISO 1-7, Monday = 1).
// Times are plain local times "HH:MM" in Asia/Gaza. routeId null = the default route.
model ScheduleDay {
  driverId  String
  weekday   Int
  working   Boolean
  startTime String
  endTime   String
  routeId   String?
  updatedAt DateTime @updatedAt
  driver    User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  route     Route?   @relation(fields: [routeId], references: [id], onDelete: SetNull)

  @@id([driverId, weekday])
}

// Processed outbox entries. The id is the phone's idempotency key: a replay
// returns the stored result instead of applying the write twice.
model OutboxEntry {
  id        String   @id
  userId    String
  kind      String
  status    String
  result    Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A trip is the time between the driver's «ابدأ الرحلة» and «خلّصت الرحلة».
// At most one open trip (endedAt null) per driver. Bookings and history hang on it later.
model Trip {
  id        String    @id
  driverId  String
  routeId   String
  // Local calendar day in Asia/Gaza, "YYYY-MM-DD".
  day       String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  driver    User      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  route     Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  bookings  Booking[]

  @@index([driverId, endedAt])
}

// The latest GPS point of a vehicle, and nothing else: one row per vehicle, overwritten
// on every update and deleted when the trip ends. Never a history.
model VehiclePosition {
  vehicleId String   @id
  lat       Float
  lon       Float
  // Metres per second, as the phone reports it. Null when it reports none.
  speed     Float?
  at        DateTime
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

// One row per planner search, kept so a real model can be trained on real demand later.
// Anonymous on purpose: no user, no IP address, no free text, and the time is rounded
// down to the hour.
model SearchLog {
  id          Int      @id @default(autoincrement())
  fromPlaceId String
  toPlaceId   String
  // What was asked about: ISO weekday (Monday = 1) and hour of the day, Asia/Gaza.
  weekday     Int
  hour        Int
  // How many options the planner found on the phone (0 = no route).
  options     Int
  // When the search happened, rounded down to the hour.
  createdAt   DateTime

  @@index([createdAt])
}

// A seat (or a few) on one driver's route on one day. The id comes from the rider's
// phone, so a replayed booking can never book twice.
// status: confirmed → ready (the driver confirmed the rider before the trip), or
// rejected (the server said no when it arrived) or cancelled (see cancelReason).
// "pending" exists only on the phone, while the booking waits in the outbox.
// Live = confirmed or ready, and not completed. Completed = its trip ended (completedAt).
model Booking {
  id                 String    @id
  riderId            String
  driverId           String
  routeId            String
  // Local calendar day in Asia/Gaza, and the time the rider asked about ("HH:MM").
  day                String
  time               String
  // Indexes into the route's stops when booked, and the places themselves, which stay
  // true if the driver later edits the route. fromPosition > toPosition = the way back.
  fromPosition       Int
  toPosition         Int
  fromPlaceId        String
  toPlaceId          String
  seats              Int
  status             String
  // rider_not_ready, schedule_change, maintenance, by_rider; for rejected: seats_gone, not_running
  cancelReason       String?
  calledAt           DateTime?
  readyAt            DateTime?
  tripId             String?
  startedAt          DateTime?
  completedAt        DateTime?
  offRouteNotifiedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  rider              User      @relation(fields: [riderId], references: [id], onDelete: Cascade)
  route              Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  trip               Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  shares             LocationShare[]

  @@index([riderId])
  @@index([driverId, day])
}

// One row per time a driver asks a rider for their location. The rider answers yes or no
// to THIS ask; there is no "always". The position (lat, lon, at) exists only between a yes
// and the end: trip start, 15 minutes after the ask, or the rider stopping. It is deleted
// then, and never copied anywhere. No history.
model LocationShare {
  id        String    @id
  bookingId String
  riderId   String
  askedAt   DateTime  @default(now())
  expiresAt DateTime
  // null = not answered yet; "yes" or "no".
  answer    String?
  // Set when sharing is over; endReason: expired, trip_started, stopped, declined.
  endedAt   DateTime?
  endReason String?
  lat       Float?
  lon       Float?
  at        DateTime?
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rider     User      @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}
